# ---- Application ----
NODE_ENV=development
APP_NAME=HRMS API
PORT=5000
API_PREFIX=/api

# For a local SQL Server Express instance, use localhost\\SQLEXPRESS.
SQL_SERVER=YOUWE\SQLEXPRESS
SQL_DATABASE=HRMS
SQL_USER=sa
SQL_PASSWORD=Youwe@2416
SQL_PORT=1433
SQL_ENCRYPT=false
SQL_TRUST_SERVER_CERTIFICATE=true

# ---- CORS ----
# Comma-separated list of allowed origins (Vite dev server by default)
CLIENT_ORIGIN=http://localhost:5173

# ---- Rate limiting (requests per window) ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# ---- Logging ----
LOG_LEVEL=debug
LOG_DIR=logs

