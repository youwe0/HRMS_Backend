# ---- Application ----
NODE_ENV=development
APP_NAME=HRMS API
PORT=5000
API_PREFIX=/api

# ---- MongoDB ----
MONGODB_URI=mongodb://127.0.0.1:27017/hrms

# ---- JWT ----
# Use long random strings in production (e.g. `openssl rand -hex 64`)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=hrms-api
JWT_REFRESH_COOKIE_NAME=refreshToken

# ---- CORS ----
# Comma-separated list of allowed origins (Vite dev server by default)
CLIENT_ORIGIN=http://localhost:5173

# ---- Rate limiting (requests per window) ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# ---- Logging ----
LOG_LEVEL=debug
LOG_DIR=logs

# ---- Realtime ----
ENABLE_SOCKETS=false

# ---- Scheduled jobs ----
JOB_CLEANUP_REFRESH_TOKENS=true
JOB_CLEANUP_REFRESH_TOKENS_SCHEDULE=0 3 * * *

# ---- Seeder ----
SEED_ADMIN_EMAIL=admin@hrms.com
SEED_ADMIN_PASSWORD=Admin@1234
